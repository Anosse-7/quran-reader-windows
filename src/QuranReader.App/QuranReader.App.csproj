<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <RequirePublisherFont Condition="'$(RequirePublisherFont)' == ''">true</RequirePublisherFont>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../QuranReader.Core/QuranReader.Core.csproj" />
    <ProjectReference Include="../QuranReader.Data/QuranReader.Data.csproj" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    <Content Include="../../content/quran-reader-data-v0.3/quran_reader_candidate.sqlite3" Condition="Exists('../../content/quran-reader-data-v0.3/quran_reader_candidate.sqlite3')" Link="Content/quran_reader_candidate.sqlite3" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/*.ttf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RequireLocalFont" BeforeTargets="BeforeBuild">
    <Error Condition="'$(RequirePublisherFont)' == 'true' and !Exists('Assets/kfgqpc_hafs_v30.ttf')" Text="Run tools/Initialize-LocalContent.ps1 with the verified publisher archive before building. Font redistribution rights remain unverified." />
  </Target>
</Project>
